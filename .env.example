# Copy this file to .env and fill in your key:   cp .env.example .env
GEMINI_API_KEY=your-key-here

# Optional
# GEMINI_MODEL=gemini-3.8-flash      # any current Gemini text model
# GEMINI_MAX_LEADS=25                # leads sent to Gemini per "Analyze all"
# USE_GEMINI=false                   # switch Gemini off without removing the key
