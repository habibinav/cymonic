# Copy to .env and add your key:   cp .env.example .env
GEMINI_API_KEY=your-key-here

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite   # default (fast). gemini-3.8-flash = richer text, slower
# GEMINI_BATCH_SIZE=8                  # leads per Gemini request
# GEMINI_PARALLEL=6                    # requests at once (lower it if you hit rate limits)
# USE_GEMINI=false                     # switch Gemini off without removing the key
