# Copy this file to .env and fill in your key:   cp .env.example .env
GEMINI_API_KEY=your-key-here

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite  # default: fast. gemini-3.8-flash = richer text, slower
# GEMINI_BATCH_SIZE=8                 # leads per Gemini request
# GEMINI_PARALLEL=6                   # requests running at the same time (lower it if you hit rate limits)
# GEMINI_MAX_LEADS=0                  # 0 = analyse every lead on "Analyze all"
# USE_GEMINI=false                    # switch Gemini off without removing the key
